# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados (No Docker dev, o DB_HOST é sobrescrito automaticamente para 'db')
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=acolher
DB_PASSWORD=acolher123
DB_NAME=ministerio_acolher
DB_ROOT_PASSWORD=root

# Sessão Administrativa
SESSION_SECRET=troque_por_uma_chave_secreta_local
ADMIN_USERNAME=admin
# Gere um hash com: node scripts/gerar-hash-senha.js "sua-senha"
# Importante: mantenha entre aspas simples para evitar interpolação do '$' pelo Docker Compose
ADMIN_PASSWORD_HASH='$2b$10$SubstituaPeloHashGeradoPeloScript'

# E-mail (SMTP Brevo)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=seu_usuario@smtp-brevo.com
EMAIL_PASS=sua_chave_smtp_brevo
EMAIL_FROM=sistema@acolher.life