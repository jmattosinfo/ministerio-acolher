# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados (No Docker dev, o DB_HOST é sobrescrito automaticamente para 'db')
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=acolher
DB_PASSWORD=acolher123
DB_NAME=ministerio_acolher
DB_ROOT_PASSWORD=root

# Sessão
SESSION_SECRET=troque_por_uma_chave_secreta_local

# Autenticação unificada (tabela `acolhedores`)
# As variáveis ADMIN_USERNAME / ADMIN_PASSWORD_HASH foram DESCONTINUADAS:
# o login agora consulta a tabela `acolhedores` (e-mail + senha_hash com bcrypt).
# Para criar o primeiro administrador, execute:
#   node scripts/criar-admin-inicial.js "Nome" "admin@acolher.life" "SuaSenhaForte"
# Para redefinir uma senha manualmente, execute:
#   node scripts/gerar-hash-senha.js "sua-senha"

# E-mail (SMTP Brevo)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=seu_usuario@smtp-brevo.com
EMAIL_PASS=sua_chave_smtp_brevo
EMAIL_FROM=sistema@acolher.life